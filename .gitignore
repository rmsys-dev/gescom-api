node_modules/
coverage/

# Pastas locais (não versionar)
docs/*
!docs/docker.md
!docs/CONTRIBUTING-DB.md

# Scripts locais ficam de fora do Git. As exceções são o lint, o migrate
# de deploy e os passos de dados do CI.
# O padrão é `scripts/**` (não `scripts/`) para a negação abaixo valer.
scripts/**
!scripts/lint-migrations.ts
!scripts/lint-migrations.config.json
!scripts/migrate.ts
!scripts/migration-lint/
!scripts/migration-lint/**
!scripts/ci/
!scripts/ci/**
postman-collections/
performance/

# Segredos locais; os exemplos continuam versionados
.env*
!.env.example
!.env.docker.example

# TypeScript
*.tsbuildinfo

# Logs e saída de pacotes
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cache de ferramentas
.eslintcache

# Pastas temporárias (uploads locais, scratch, etc.)
tmp/
temp/

# XML fiscal das notas (NFE_XML_DIR)
storage/

# Fotos de membros e produtos (PHOTOS_DIR)
fotos/

# Chaves e certificados (não versionar material criptográfico local)
*.pem
*.p12
*.pfx

.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

.idea/
.vscode/
.cursor/

dist/
