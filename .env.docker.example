# Copie para .env.docker e substitua os placeholders.
# Docker --env-file NAO remove aspas: use sempre KEY=valor, sem aspas.
# Nao versione o .env.docker.
# A imagem ja define NODE_ENV, PORT, CHROME_EXECUTABLE_PATH, PHOTOS_DIR e NFE_XML_DIR;
# os valores abaixo sobrescrevem esses defaults quando o container sobe com --env-file.

# Configuracao geral
# development | test | production (padrao da imagem: production)
NODE_ENV=production
PORT=3000

# PostgreSQL
# DATABASE_URL: conexao da aplicacao em runtime.
#   Supabase pooler (transaction): porta 6543 e ?pgbouncer=true
#   Postgres direto: porta 5432, sem pgbouncer
# DRIZZLE_DATABASE_URL: drizzle-kit e migrations no entrypoint. Sempre porta 5432
#   (session mode ou direto). Nao use o pooler 6543.
# No container de producao as duas URLs costumam apontar para o mesmo Postgres direto.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DRIZZLE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# JWT (secrets com no minimo 32 caracteres; tempos no formato do jsonwebtoken: 15m, 7d)
JWT_SECRET=change-me-jwt-secret-min-32-chars!!
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=gescom_api
JWT_AUDIENCE=gescom_clients
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret-min-32!!
JWT_REFRESH_EXPIRES_IN=7d

# Auth / rate limit
BCRYPT_ROUNDS=12
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_BASE_MINUTES=5
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=180

# CORS (lista separada por virgulas; pelo menos uma origem)
CORS_ORIGINS=https://app.exemplo.com

# RMSys / maintainer — rotas em /v1/maintainer/* (cabecalho X-Maintainer-Api-Key; minimo 32 caracteres)
MAINTAINER_API_KEY=change-me-maintainer-api-key-32chars

# Resend (e-mail)
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM=noreply@exemplo.com
MAIL_FROM_NAME=Gescom
EMAIL_SEND_RATE_LIMIT_WINDOW_MS=60000
EMAIL_SEND_RATE_LIMIT_MAX=30

# Primeiro acesso
FIRST_ACCESS_RATE_LIMIT_WINDOW_MS=900000
FIRST_ACCESS_RATE_LIMIT_MAX=10
FIRST_ACCESS_EMAIL_LIMIT_WINDOW_MINUTES=60
FIRST_ACCESS_EMAIL_LIMIT_MAX=3
INVITATION_CODE_TTL_MINUTES=60
INVITATION_MAX_ATTEMPTS=5
INVITATION_CODE_LENGTH=6
FIRST_ACCESS_CONFIRM_TTL_MINUTES=15

# Redefinicao de senha
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_RESET_RATE_LIMIT_MAX=10
PASSWORD_RESET_EMAIL_LIMIT_WINDOW_MINUTES=60
PASSWORD_RESET_EMAIL_LIMIT_MAX=3
PASSWORD_RESET_CODE_TTL_MINUTES=60
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_CODE_LENGTH=6
PASSWORD_RESET_CONFIRM_TTL_MINUTES=15

# NF-e / NFC-e (NFE_SECRETS_KEY minimo 32 caracteres)
# NFE_XML_DIR fica em /app/storage/nfe e o volume gescom-storage monta /app/storage
NFE_TIMEOUT_MS=15000
NFE_SECRETS_KEY=change-me-nfe-secrets-key-min-32-chars!!
NFE_XML_DIR=storage/nfe

# Fotos de membros e produtos
# PHOTOS_DIR fica em /app/fotos e o volume gescom-fotos monta esse caminho
PHOTOS_DIR=fotos

# PDF (Playwright). Chromium embutido na imagem Debian.
CHROME_EXECUTABLE_PATH=/usr/bin/chromium
