{
  "name": "gescom_erp",
  "version": "1.0.0",
  "description": "ERP Gescom",
  "license": "ISC",
  "author": "RMSys",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec tsx src/server.ts",
    "dev:poll": "nodemon --legacy-watch --watch src --ext ts --exec tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/apply-pending-migrations.ts",
    "db:check-migrations": "tsx scripts/db/check-migrations-status.ts",
    "db:check-pending-migrations": "tsx scripts/db/check-pending-migration-files.ts",
    "db:compare-prod-schema": "tsx scripts/db/compare-prod-schema.ts",
    "db:backup:snapshot": "tsx scripts/db/capture-pre-migration-snapshot.ts",
    "db:push": "drizzle-kit push",
    "db:register:pending-migration-hashes": "tsx scripts/db/register-pending-migration-hashes.ts",
    "db:repair-pending-migration-sql": "tsx scripts/db/repair-pending-migration-sql.ts",
    "db:sync-pending-migration-hashes": "tsx scripts/db/repair-pending-migration-sql.ts --sync-hashes-only",
    "postman:generate": "node postman-collections/generate-complete-collection.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "axios": "^1.15.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.75.2",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "postgres": "^3.4.9",
    "resend": "^6.12.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "autocannon": "^8.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.1",
    "md-to-pdf": "^5.2.4",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0"
  }
}
