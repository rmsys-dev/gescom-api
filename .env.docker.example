# Copie para .env.docker e preencha com valores reais (nao versionar .env.docker).
# Uso: npm run docker:run  ou  docker run --rm -p 3000:3000 --shm-size=1g --env-file .env.docker gescom-api:latest
#
# IMPORTANTE: Docker --env-file NAO remove aspas. Use sempre KEY=value sem aspas.
# (Diferente do dotenv/.env local, que aceita aspas.)

NODE_ENV=production
PORT=3000

# PostgreSQL / Supabase externo — DRIZZLE_DATABASE_URL na porta 5432 (session mode; nao use pooler 6543)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DRIZZLE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# JWT (minimo 32 caracteres nos secrets)
JWT_SECRET=change-me-jwt-secret-min-32-chars!!
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=gescom_api
JWT_AUDIENCE=gescom_clients
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret-min-32!!
JWT_REFRESH_EXPIRES_IN=7d

# Auth / rate limit
BCRYPT_ROUNDS=12
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_BASE_MINUTES=5
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300

# CORS (lista separada por virgulas)
CORS_ORIGINS=https://app.exemplo.com

# Maintainer (minimo 32 caracteres)
MAINTAINER_API_KEY=change-me-maintainer-api-key-32chars

# Resend
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM=noreply@exemplo.com
MAIL_FROM_NAME=Gescom
EMAIL_SEND_RATE_LIMIT_WINDOW_MS=60000
EMAIL_SEND_RATE_LIMIT_MAX=30

# Primeiro acesso
FIRST_ACCESS_RATE_LIMIT_WINDOW_MS=900000
FIRST_ACCESS_RATE_LIMIT_MAX=5
FIRST_ACCESS_EMAIL_LIMIT_WINDOW_MINUTES=60
FIRST_ACCESS_EMAIL_LIMIT_MAX=3
INVITATION_CODE_TTL_MINUTES=60
INVITATION_MAX_ATTEMPTS=5
INVITATION_CODE_LENGTH=6
FIRST_ACCESS_CONFIRM_TTL_MINUTES=15

# Redefinicao de senha
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_RESET_RATE_LIMIT_MAX=5
PASSWORD_RESET_EMAIL_LIMIT_WINDOW_MINUTES=60
PASSWORD_RESET_EMAIL_LIMIT_MAX=3
PASSWORD_RESET_CODE_TTL_MINUTES=60
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_CODE_LENGTH=6
PASSWORD_RESET_CONFIRM_TTL_MINUTES=15

# NF-e / NFC-e (NFE_SECRETS_KEY minimo 32 caracteres)
NFE_TIMEOUT_MS=15000
NFE_SECRETS_KEY=change-me-nfe-secrets-key-min-32-chars!!
NFE_XML_DIR=storage/nfe

# Fotos (membros / produtos) — persistir com volume Docker
PHOTOS_DIR=fotos

# Chromium embutido na imagem (path padrao Debian)
CHROME_EXECUTABLE_PATH=/usr/bin/chromium
